# ===== COLE SEU TOKEN AQUI (NUNCA COMPARTILHE NEM UPE PRO GITHUB) =====
TOKEN=seu_token_aqui
CLIENT_ID=id_da_aplicacao_aqui
GUILD_ID=id_do_servidor_para_testes_aqui

# ID do cargo da equipe que vai atender os tickets (botão direito no cargo > Copiar ID)
STAFF_ROLE_ID=id_do_cargo_staff_aqui

# ID da categoria onde os tickets serão criados (botão direito > Copiar ID)
# Se deixar vazio, o bot cria no topo do servidor
TICKET_CATEGORY_ID=

# Canal de logs (onde manda ticket criado/fechado/entrou/saiu) - recomendado
LOG_CHANNEL_ID=

# ===== AUTO-ROLE + BOAS-VINDAS (novo!) =====
# Cargo que todo mundo ganha ao entrar (ID). Deixe vazio pra desativar.
AUTO_ROLE_ID=

# Canal de boas-vindas (ID). Deixe vazio pra desativar.
WELCOME_CHANNEL_ID=
# Mensagem de boas-vindas. Use {user} = marca a pessoa, {server} = nome do servidor
WELCOME_MESSAGE=Olá {user}, bem-vindo(a) ao **{server}**! 🎉 Abra um ticket se precisar de ajuda.

# ===== NOVIDADES =====
# Auto-close: fecha ticket parado há X horas (0 = desativa)
INACTIVE_HOURS=24

# Anti-link de convite (true/false). Equipe está imune.
ANTILINK=true

# Palavras proibidas separadas por vírgula (equipe imune)
BADWORDS=fdp,vsf,otario,otário,idiota

# Cor do embed
EMBED_COLOR=#5865F2

# Porta do servidor keep-alive (o Render usa isso pra não derrubar)
PORT=3000
